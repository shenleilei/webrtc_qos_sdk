diff --git a/sdk_qos/h264_rtp_adapter_smoke.cc b/sdk_qos/h264_rtp_adapter_smoke.cc
new file mode 100644
index 0000000..ee2f082
--- /dev/null
+++ b/sdk_qos/h264_rtp_adapter_smoke.cc
@@ -0,0 +1,80 @@
+#include <cstdint>
+#include <iostream>
+#include <vector>
+
+#include "sdk_qos/h264_rtp_adapter.h"
+
+namespace {
+
+bool Check(bool condition, const char* message) {
+  if (!condition) {
+    std::cerr << "FAIL: " << message << "\n";
+    return false;
+  }
+  return true;
+}
+
+std::vector<uint8_t> MakeAnnexBIdr(size_t payload_bytes) {
+  std::vector<uint8_t> au = {0x00, 0x00, 0x00, 0x01, 0x65};
+  for (size_t i = 0; i < payload_bytes; ++i) {
+    au.push_back(static_cast<uint8_t>(0x80 + (i % 31)));
+  }
+  return au;
+}
+
+}  // namespace
+
+int main() {
+  bool ok = true;
+
+  std::vector<webrtc_qos::H264RtpPayload> payloads;
+  std::vector<uint8_t> small_idr = MakeAnnexBIdr(16);
+  ok &= Check(webrtc_qos::PacketizeH264AnnexB(
+                  small_idr.data(), small_idr.size(), {1200}, &payloads),
+              "packetize small idr");
+  ok &= Check(payloads.size() == 1, "small idr uses one payload");
+  ok &= Check(payloads[0].marker, "single payload marker");
+  ok &= Check(payloads[0].first_packet_in_frame, "single payload first");
+  ok &= Check(payloads[0].keyframe, "single payload keyframe");
+  ok &= Check(!payloads[0].payload.empty() && payloads[0].payload[0] == 0x65,
+              "single nalu payload");
+
+  webrtc_qos::H264DepacketizedPayload depacketized;
+  ok &= Check(webrtc_qos::DepacketizeH264Payload(
+                  payloads[0].payload.data(), payloads[0].payload.size(),
+                  &depacketized),
+              "depacketize single nalu");
+  ok &= Check(depacketized.valid, "single nalu valid");
+  ok &= Check(depacketized.keyframe, "single nalu keyframe");
+  ok &= Check(depacketized.nalu_type == 5, "single nalu type idr");
+
+  std::vector<uint8_t> large_idr = MakeAnnexBIdr(180);
+  ok &= Check(webrtc_qos::PacketizeH264AnnexB(
+                  large_idr.data(), large_idr.size(), {50}, &payloads),
+              "packetize large idr");
+  ok &= Check(payloads.size() > 1, "large idr uses FU-A payloads");
+  ok &= Check(payloads.front().first_packet_in_frame, "fua first packet");
+  ok &= Check(!payloads.front().marker, "fua first marker false");
+  ok &= Check(payloads.back().marker, "fua last marker true");
+  ok &= Check(payloads.front().payload.size() >= 2 &&
+                  (payloads.front().payload[0] & 0x1f) == 28 &&
+                  (payloads.front().payload[1] & 0x80) != 0,
+              "fua start bit");
+  ok &= Check(payloads.back().payload.size() >= 2 &&
+                  (payloads.back().payload[1] & 0x40) != 0,
+              "fua end bit");
+
+  ok &= Check(webrtc_qos::DepacketizeH264Payload(
+                  payloads.front().payload.data(),
+                  payloads.front().payload.size(), &depacketized),
+              "depacketize fua start");
+  ok &= Check(depacketized.keyframe, "fua keyframe");
+  ok &= Check(depacketized.nalu_type == 5, "fua original nalu type idr");
+
+  if (!ok) {
+    return 1;
+  }
+  std::cout << "h264_rtp_adapter_smoke passed payloads=" << payloads.size()
+            << "\n";
+  return 0;
+}
