@@ -0,0 +1,281 @@
+#include "sdk_qos/rtcp_adapter.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <utility>
+
+#include "api/units/time_delta.h"
+#include "api/units/timestamp.h"
+#include "modules/rtp_rtcp/source/rtcp_packet/common_header.h"
+#include "modules/rtp_rtcp/source/rtcp_packet/nack.h"
+#include "modules/rtp_rtcp/source/rtcp_packet/pli.h"
+#include "modules/rtp_rtcp/source/rtcp_packet/receiver_report.h"
+#include "modules/rtp_rtcp/source/rtcp_packet/report_block.h"
+#include "modules/rtp_rtcp/source/rtcp_packet/sender_report.h"
+#include "modules/rtp_rtcp/source/rtcp_packet/transport_feedback.h"
+#include "rtc_base/buffer.h"
+#include "system_wrappers/include/ntp_time.h"
+
+namespace webrtc_qos {
+namespace {
+
+bool CopyBuiltPacket(const webrtc::Buffer& packet, std::vector<uint8_t>* out) {
+  if (!out || packet.empty()) {
+    return false;
+  }
+  const std::span<const uint8_t> packet_view(packet.data(), packet.size());
+  out->assign(packet_view.begin(), packet_view.end());
+  return true;
+}
+
+bool ParseHeader(const uint8_t* data,
+                 size_t size,
+                 webrtc::rtcp::CommonHeader* header) {
+  return data && size >= webrtc::rtcp::CommonHeader::kHeaderSizeBytes &&
+         header && header->Parse(data, size);
+}
+
+webrtc::rtcp::ReportBlock ToWebRtcReportBlock(
+    const RtcpAdapterReportBlock& input) {
+  webrtc::rtcp::ReportBlock block;
+  block.SetMediaSsrc(input.media_ssrc);
+  block.SetFractionLost(input.fraction_lost);
+  block.SetCumulativeLost(input.cumulative_lost);
+  block.SetExtHighestSeqNum(input.extended_high_seq_num);
+  block.SetJitter(input.jitter);
+  block.SetLastSr(input.last_sr);
+  block.SetDelayLastSr(input.delay_since_last_sr);
+  return block;
+}
+
+RtcpAdapterReportBlock FromWebRtcReportBlock(
+    const webrtc::rtcp::ReportBlock& input) {
+  RtcpAdapterReportBlock block;
+  block.media_ssrc = input.source_ssrc();
+  block.fraction_lost = input.fraction_lost();
+  block.cumulative_lost = input.cumulative_lost();
+  block.extended_high_seq_num = input.extended_high_seq_num();
+  block.jitter = input.jitter();
+  block.last_sr = input.last_sr();
+  block.delay_since_last_sr = input.delay_since_last_sr();
+  return block;
+}
+
+}  // namespace
+
+bool BuildRtcpSenderReport(const RtcpAdapterSenderReport& input,
+                           std::vector<uint8_t>* out) {
+  webrtc::rtcp::SenderReport packet;
+  packet.SetSenderSsrc(input.sender_ssrc);
+  packet.SetNtp(webrtc::NtpTime(input.ntp_seconds, input.ntp_fractions));
+  packet.SetRtpTimestamp(input.rtp_timestamp);
+  packet.SetPacketCount(input.packet_count);
+  packet.SetOctetCount(input.octet_count);
+  for (const auto& block : input.report_blocks) {
+    if (!packet.AddReportBlock(ToWebRtcReportBlock(block))) {
+      return false;
+    }
+  }
+  return CopyBuiltPacket(packet.Build(), out);
+}
+
+bool ParseRtcpSenderReport(const uint8_t* data,
+                           size_t size,
+                           RtcpAdapterSenderReport* out) {
+  webrtc::rtcp::CommonHeader header;
+  if (!out || !ParseHeader(data, size, &header) ||
+      header.type() != webrtc::rtcp::SenderReport::kPacketType) {
+    return false;
+  }
+  webrtc::rtcp::SenderReport packet;
+  if (!packet.Parse(header)) {
+    return false;
+  }
+  out->sender_ssrc = packet.sender_ssrc();
+  out->ntp_seconds = packet.ntp().seconds();
+  out->ntp_fractions = packet.ntp().fractions();
+  out->rtp_timestamp = packet.rtp_timestamp();
+  out->packet_count = packet.sender_packet_count();
+  out->octet_count = packet.sender_octet_count();
+  out->report_blocks.clear();
+  for (const auto& block : packet.report_blocks()) {
+    out->report_blocks.push_back(FromWebRtcReportBlock(block));
+  }
+  return true;
+}
+
+bool BuildRtcpReceiverReport(const RtcpAdapterReceiverReport& input,
+                             std::vector<uint8_t>* out) {
+  webrtc::rtcp::ReceiverReport packet;
+  packet.SetSenderSsrc(input.sender_ssrc);
+  for (const auto& block : input.report_blocks) {
+    if (!packet.AddReportBlock(ToWebRtcReportBlock(block))) {
+      return false;
+    }
+  }
+  return CopyBuiltPacket(packet.Build(), out);
+}
+
+bool ParseRtcpReceiverReport(const uint8_t* data,
+                             size_t size,
+                             RtcpAdapterReceiverReport* out) {
+  webrtc::rtcp::CommonHeader header;
+  if (!out || !ParseHeader(data, size, &header) ||
+      header.type() != webrtc::rtcp::ReceiverReport::kPacketType) {
+    return false;
+  }
+  webrtc::rtcp::ReceiverReport packet;
+  if (!packet.Parse(header)) {
+    return false;
+  }
+  out->sender_ssrc = packet.sender_ssrc();
+  out->report_blocks.clear();
+  for (const auto& block : packet.report_blocks()) {
+    out->report_blocks.push_back(FromWebRtcReportBlock(block));
+  }
+  return true;
+}
+
+bool BuildRtcpTransportFeedback(
+    const RtcpAdapterTransportFeedback& input,
+    std::vector<uint8_t>* out) {
+  webrtc::rtcp::TransportFeedback packet;
+  packet.SetSenderSsrc(input.sender_ssrc);
+  packet.SetMediaSsrc(input.media_ssrc);
+  packet.SetBase(input.base_sequence,
+                 webrtc::Timestamp::Micros(input.base_time_us));
+  packet.SetFeedbackSequenceNumber(input.feedback_sequence);
+  for (const auto& item : input.packets) {
+    if (item.delta_since_base_us < 0) {
+      continue;
+    }
+    if (!packet.AddReceivedPacket(
+            item.sequence_number,
+            webrtc::Timestamp::Micros(input.base_time_us +
+                                      item.delta_since_base_us))) {
+      return false;
+    }
+  }
+  return CopyBuiltPacket(packet.Build(), out);
+}
+
+bool ParseRtcpTransportFeedback(const uint8_t* data,
+                                size_t size,
+                                RtcpAdapterTransportFeedback* out) {
+  webrtc::rtcp::CommonHeader header;
+  if (!out || !ParseHeader(data, size, &header) ||
+      header.type() != webrtc::rtcp::Rtpfb::kPacketType ||
+      header.fmt() != webrtc::rtcp::TransportFeedback::kFeedbackMessageType) {
+    return false;
+  }
+  webrtc::rtcp::TransportFeedback packet;
+  if (!packet.Parse(header)) {
+    return false;
+  }
+  out->sender_ssrc = packet.sender_ssrc();
+  out->media_ssrc = packet.media_ssrc();
+  out->base_sequence = packet.GetBaseSequence();
+  out->base_time_us = packet.BaseTime().us();
+  if (size < 20) {
+    return false;
+  }
+  const std::span<const uint8_t> packet_view(data, size);
+  out->feedback_sequence = packet_view[19];
+  out->packets.clear();
+  packet.ForAllPackets([&](uint16_t sequence_number,
+                           webrtc::TimeDelta delta_since_base) {
+    RtcpAdapterTransportFeedbackPacket item;
+    item.sequence_number = sequence_number;
+    item.delta_since_base_us = delta_since_base.IsPlusInfinity()
+                                   ? -1
+                                   : delta_since_base.us();
+    out->packets.push_back(item);
+  });
+  return true;
+}
+
+bool BuildRtcpNack(const RtcpAdapterNack& input, std::vector<uint8_t>* out) {
+  webrtc::rtcp::Nack packet;
+  packet.SetSenderSsrc(input.sender_ssrc);
+  packet.SetMediaSsrc(input.media_ssrc);
+  packet.SetPacketIds(input.packet_ids);
+  return CopyBuiltPacket(packet.Build(), out);
+}
+
+bool ParseRtcpNack(const uint8_t* data, size_t size, RtcpAdapterNack* out) {
+  webrtc::rtcp::CommonHeader header;
+  if (!out || !ParseHeader(data, size, &header) ||
+      header.type() != webrtc::rtcp::Rtpfb::kPacketType ||
+      header.fmt() != webrtc::rtcp::Nack::kFeedbackMessageType) {
+    return false;
+  }
+  webrtc::rtcp::Nack packet;
+  if (!packet.Parse(header)) {
+    return false;
+  }
+  out->sender_ssrc = packet.sender_ssrc();
+  out->media_ssrc = packet.media_ssrc();
+  out->packet_ids = packet.packet_ids();
+  return true;
+}
+
+bool BuildRtcpPli(const RtcpAdapterPli& input, std::vector<uint8_t>* out) {
+  webrtc::rtcp::Pli packet;
+  packet.SetSenderSsrc(input.sender_ssrc);
+  packet.SetMediaSsrc(input.media_ssrc);
+  return CopyBuiltPacket(packet.Build(), out);
+}
+
+bool ParseRtcpPli(const uint8_t* data, size_t size, RtcpAdapterPli* out) {
+  webrtc::rtcp::CommonHeader header;
+  if (!out || !ParseHeader(data, size, &header) ||
+      header.type() != webrtc::rtcp::Psfb::kPacketType ||
+      header.fmt() != webrtc::rtcp::Pli::kFeedbackMessageType) {
+    return false;
+  }
+  webrtc::rtcp::Pli packet;
+  if (!packet.Parse(header)) {
+    return false;
+  }
+  out->sender_ssrc = packet.sender_ssrc();
+  out->media_ssrc = packet.media_ssrc();
+  return true;
+}
+
+bool ParseRtcpPacket(const uint8_t* data,
+                     size_t size,
+                     RtcpAdapterParsedPacket* out) {
+  webrtc::rtcp::CommonHeader header;
+  if (!out || !ParseHeader(data, size, &header)) {
+    return false;
+  }
+  *out = RtcpAdapterParsedPacket{};
+  if (header.type() == webrtc::rtcp::SenderReport::kPacketType) {
+    out->type = RtcpAdapterPacketType::kSenderReport;
+    return ParseRtcpSenderReport(data, size, &out->sender_report);
+  }
+  if (header.type() == webrtc::rtcp::ReceiverReport::kPacketType) {
+    out->type = RtcpAdapterPacketType::kReceiverReport;
+    return ParseRtcpReceiverReport(data, size, &out->receiver_report);
+  }
+  if (header.type() == webrtc::rtcp::Rtpfb::kPacketType &&
+      header.fmt() == webrtc::rtcp::TransportFeedback::kFeedbackMessageType) {
+    out->type = RtcpAdapterPacketType::kTransportFeedback;
+    return ParseRtcpTransportFeedback(data, size, &out->transport_feedback);
+  }
+  if (header.type() == webrtc::rtcp::Rtpfb::kPacketType &&
+      header.fmt() == webrtc::rtcp::Nack::kFeedbackMessageType) {
+    out->type = RtcpAdapterPacketType::kNack;
+    return ParseRtcpNack(data, size, &out->nack);
+  }
+  if (header.type() == webrtc::rtcp::Psfb::kPacketType &&
+      header.fmt() == webrtc::rtcp::Pli::kFeedbackMessageType) {
+    out->type = RtcpAdapterPacketType::kPli;
+    return ParseRtcpPli(data, size, &out->pli);
+  }
+  return false;
+}
+
+}  // namespace webrtc_qos
diff --git a/sdk_qos/rtcp_adapter.h b/sdk_qos/rtcp_adapter.h
