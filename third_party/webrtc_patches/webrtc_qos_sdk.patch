+#include "sdk_qos/nack_requester_adapter.h"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "absl/functional/any_invocable.h"
+#include "api/field_trials_view.h"
+#include "api/location.h"
+#include "api/task_queue/task_queue_base.h"
+#include "api/units/time_delta.h"
+#include "modules/include/module_common_types.h"
+#include "modules/video_coding/nack_requester.h"
+#include "system_wrappers/include/clock.h"
+
+namespace webrtc_qos {
+namespace {
+
+class EmptyFieldTrials final : public webrtc::FieldTrialsView {
+ public:
+  std::string Lookup(absl::string_view) const override { return ""; }
+};
+
+class InlineTaskQueue final : public webrtc::TaskQueueBase {
+ public:
+  class ScopedCurrent {
+   public:
+    explicit ScopedCurrent(InlineTaskQueue* queue) : current_(queue) {}
+
+    ScopedCurrent(const ScopedCurrent&) = delete;
+    ScopedCurrent& operator=(const ScopedCurrent&) = delete;
+
+   private:
+    CurrentTaskQueueSetter current_;
+  };
+
+  void Delete() override {}
+
+ private:
+  void PostTaskImpl(absl::AnyInvocable<void() &&> task,
+                    const PostTaskTraits&,
+                    const webrtc::Location&) override {
+    ScopedCurrent current(this);
+    std::move(task)();
+  }
+
+  void PostDelayedTaskImpl(absl::AnyInvocable<void() &&>,
+                           webrtc::TimeDelta,
+                           const PostDelayedTaskTraits&,
+                           const webrtc::Location&) override {
+    // The SDK facade drives ProcessNacks() explicitly. Periodic delayed tasks
+    // are intentionally not scheduled here to keep this adapter single-threaded
+    // and transport-owned.
+  }
+};
+
+class EventSink final : public webrtc::NackSender,
+                        public webrtc::KeyFrameRequestSender {
+ public:
+  void SendNack(const std::vector<uint16_t>& sequence_numbers,
+                bool buffering_allowed) override {
+    NackRequesterAdapterEvent event;
+    event.type = NackRequesterAdapterEventType::kNack;
+    event.buffering_allowed = buffering_allowed;
+    event.rtp_sequence_numbers = sequence_numbers;
+    events_.push_back(std::move(event));
+  }
+
+  void RequestKeyFrame() override {
+    NackRequesterAdapterEvent event;
+    event.type = NackRequesterAdapterEventType::kKeyFrameRequest;
+    events_.push_back(std::move(event));
+  }
+
+  std::vector<NackRequesterAdapterEvent> DrainEvents() {
+    std::vector<NackRequesterAdapterEvent> out;
+    out.swap(events_);
+    return out;
+  }
+
+ private:
+  std::vector<NackRequesterAdapterEvent> events_;
+};
+
+}  // namespace
+
+class NackRequesterAdapter::Impl {
+ public:
+  explicit Impl(const NackRequesterAdapterConfig& config)
+      : current_(&queue_),
+        periodic_processor_(webrtc::TimeDelta::PlusInfinity()),
+        clock_(0),
+        requester_(&queue_,
+                   &periodic_processor_,
+                   &clock_,
+                   &event_sink_,
+                   &event_sink_,
+                   field_trials_) {
+    requester_.UpdateRtt(config.rtt_ms);
+  }
+
+  int OnReceivedPacket(uint16_t rtp_sequence_number, bool is_recovered) {
+    return requester_.OnReceivedPacket(rtp_sequence_number, is_recovered);
+  }
+
+  void ClearUpTo(uint16_t rtp_sequence_number) {
+    requester_.ClearUpTo(rtp_sequence_number);
+  }
+
+  void UpdateRtt(int64_t rtt_ms) { requester_.UpdateRtt(rtt_ms); }
+
+  void ProcessNacks() { requester_.ProcessNacks(); }
+
+  std::vector<NackRequesterAdapterEvent> DrainEvents() {
+    return event_sink_.DrainEvents();
+  }
+
+ private:
+  InlineTaskQueue queue_;
+  InlineTaskQueue::ScopedCurrent current_;
+  EmptyFieldTrials field_trials_;
+  webrtc::NackPeriodicProcessor periodic_processor_;
+  webrtc::SimulatedClock clock_;
+  EventSink event_sink_;
+  webrtc::NackRequester requester_;
+};
+
+NackRequesterAdapter::NackRequesterAdapter(
+    const NackRequesterAdapterConfig& config)
+    : impl_(std::make_unique<Impl>(config)) {}
+
+NackRequesterAdapter::~NackRequesterAdapter() = default;
+
+int NackRequesterAdapter::OnReceivedPacket(uint16_t rtp_sequence_number,
+                                           bool is_recovered) {
+  return impl_->OnReceivedPacket(rtp_sequence_number, is_recovered);
+}
+
+void NackRequesterAdapter::ClearUpTo(uint16_t rtp_sequence_number) {
+  impl_->ClearUpTo(rtp_sequence_number);
+}
+
+void NackRequesterAdapter::UpdateRtt(int64_t rtt_ms) {
+  impl_->UpdateRtt(rtt_ms);
+}
+
+void NackRequesterAdapter::ProcessNacks() {
+  impl_->ProcessNacks();
+}
+
+std::vector<NackRequesterAdapterEvent> NackRequesterAdapter::DrainEvents() {
+  return impl_->DrainEvents();
+}
+
+NackRequesterAdapter* CreateNackRequesterAdapter(
+    const NackRequesterAdapterConfig& config) {
+  return new NackRequesterAdapter(config);
+}
+
+void DestroyNackRequesterAdapter(NackRequesterAdapter* adapter) {
+  delete adapter;
+}
+
+}  // namespace webrtc_qos
