+#ifndef SDK_QOS_RTCP_ADAPTER_H_
+#define SDK_QOS_RTCP_ADAPTER_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace webrtc_qos {
+
+struct RtcpAdapterReportBlock {
+  uint32_t media_ssrc = 0;
+  uint8_t fraction_lost = 0;
+  int32_t cumulative_lost = 0;
+  uint32_t extended_high_seq_num = 0;
+  uint32_t jitter = 0;
+  uint32_t last_sr = 0;
+  uint32_t delay_since_last_sr = 0;
+};
+
+struct RtcpAdapterSenderReport {
+  uint32_t sender_ssrc = 0;
+  uint32_t ntp_seconds = 0;
+  uint32_t ntp_fractions = 0;
+  uint32_t rtp_timestamp = 0;
+  uint32_t packet_count = 0;
+  uint32_t octet_count = 0;
+  std::vector<RtcpAdapterReportBlock> report_blocks;
+};
+
+struct RtcpAdapterReceiverReport {
+  uint32_t sender_ssrc = 0;
+  std::vector<RtcpAdapterReportBlock> report_blocks;
+};
+
+struct RtcpAdapterTransportFeedbackPacket {
+  uint16_t sequence_number = 0;
+  int64_t delta_since_base_us = -1;
+};
+
+struct RtcpAdapterTransportFeedback {
+  uint32_t sender_ssrc = 0;
+  uint32_t media_ssrc = 0;
+  uint16_t base_sequence = 0;
+  int64_t base_time_us = 0;
+  uint8_t feedback_sequence = 0;
+  std::vector<RtcpAdapterTransportFeedbackPacket> packets;
+};
+
+struct RtcpAdapterNack {
+  uint32_t sender_ssrc = 0;
+  uint32_t media_ssrc = 0;
+  std::vector<uint16_t> packet_ids;
+};
+
+struct RtcpAdapterPli {
+  uint32_t sender_ssrc = 0;
+  uint32_t media_ssrc = 0;
+};
+
+enum class RtcpAdapterPacketType {
+  kUnknown = 0,
+  kSenderReport,
+  kReceiverReport,
+  kTransportFeedback,
+  kNack,
+  kPli,
+};
+
+struct RtcpAdapterParsedPacket {
+  RtcpAdapterPacketType type = RtcpAdapterPacketType::kUnknown;
+  RtcpAdapterSenderReport sender_report;
+  RtcpAdapterReceiverReport receiver_report;
+  RtcpAdapterTransportFeedback transport_feedback;
+  RtcpAdapterNack nack;
+  RtcpAdapterPli pli;
+};
+
+bool BuildRtcpSenderReport(const RtcpAdapterSenderReport& input,
+                           std::vector<uint8_t>* out);
+bool ParseRtcpSenderReport(const uint8_t* data,
+                           size_t size,
+                           RtcpAdapterSenderReport* out);
+
+bool BuildRtcpReceiverReport(const RtcpAdapterReceiverReport& input,
+                             std::vector<uint8_t>* out);
+bool ParseRtcpReceiverReport(const uint8_t* data,
+                             size_t size,
+                             RtcpAdapterReceiverReport* out);
+
+bool BuildRtcpTransportFeedback(
+    const RtcpAdapterTransportFeedback& input,
+    std::vector<uint8_t>* out);
+bool ParseRtcpTransportFeedback(const uint8_t* data,
+                                size_t size,
+                                RtcpAdapterTransportFeedback* out);
+
+bool BuildRtcpNack(const RtcpAdapterNack& input, std::vector<uint8_t>* out);
+bool ParseRtcpNack(const uint8_t* data, size_t size, RtcpAdapterNack* out);
+
+bool BuildRtcpPli(const RtcpAdapterPli& input, std::vector<uint8_t>* out);
+bool ParseRtcpPli(const uint8_t* data, size_t size, RtcpAdapterPli* out);
+
+bool ParseRtcpPacket(const uint8_t* data,
+                     size_t size,
+                     RtcpAdapterParsedPacket* out);
+
+}  // namespace webrtc_qos
+
+#endif  // SDK_QOS_RTCP_ADAPTER_H_
diff --git a/sdk_qos/rtcp_adapter_smoke.cc b/sdk_qos/rtcp_adapter_smoke.cc
new file mode 100644
index 0000000..a54f520
--- /dev/null
+++ b/sdk_qos/rtcp_adapter_smoke.cc
@@ -0,0 +1,118 @@
+#include <cstdint>
+#include <iostream>
+#include <vector>
+
+#include "sdk_qos/rtcp_adapter.h"
+
+namespace {
+
+bool Check(bool condition, const char* message) {
+  if (!condition) {
+    std::cerr << "FAIL: " << message << "\n";
+    return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+int main() {
+  bool ok = true;
+  std::vector<uint8_t> bytes;
+
+  webrtc_qos::RtcpAdapterPli pli{0x11111111, 0x22222222};
+  ok &= Check(webrtc_qos::BuildRtcpPli(pli, &bytes), "build PLI");
+  webrtc_qos::RtcpAdapterPli parsed_pli;
+  ok &= Check(webrtc_qos::ParseRtcpPli(bytes.data(), bytes.size(),
+                                       &parsed_pli),
+              "parse PLI");
+  ok &= Check(parsed_pli.sender_ssrc == pli.sender_ssrc &&
+                  parsed_pli.media_ssrc == pli.media_ssrc,
+              "PLI roundtrip");
+
+  webrtc_qos::RtcpAdapterNack nack;
+  nack.sender_ssrc = 0x11111111;
+  nack.media_ssrc = 0x22222222;
+  nack.packet_ids = {7, 8, 23, 42};
+  ok &= Check(webrtc_qos::BuildRtcpNack(nack, &bytes), "build NACK");
+  webrtc_qos::RtcpAdapterNack parsed_nack;
+  ok &= Check(webrtc_qos::ParseRtcpNack(bytes.data(), bytes.size(),
+                                        &parsed_nack),
+              "parse NACK");
+  ok &= Check(parsed_nack.packet_ids == nack.packet_ids, "NACK packet ids");
+
+  webrtc_qos::RtcpAdapterReceiverReport rr;
+  rr.sender_ssrc = 0x11111111;
+  rr.report_blocks.push_back(
+      webrtc_qos::RtcpAdapterReportBlock{0x22222222, 13, 3, 90000, 77, 88, 99});
+  ok &= Check(webrtc_qos::BuildRtcpReceiverReport(rr, &bytes), "build RR");
+  webrtc_qos::RtcpAdapterReceiverReport parsed_rr;
+  ok &= Check(webrtc_qos::ParseRtcpReceiverReport(bytes.data(), bytes.size(),
+                                                  &parsed_rr),
+              "parse RR");
+  ok &= Check(parsed_rr.sender_ssrc == rr.sender_ssrc &&
+                  parsed_rr.report_blocks.size() == 1 &&
+                  parsed_rr.report_blocks[0].media_ssrc == 0x22222222 &&
+                  parsed_rr.report_blocks[0].last_sr == 88,
+              "RR roundtrip");
+
+  webrtc_qos::RtcpAdapterSenderReport sr;
+  sr.sender_ssrc = 0x11111111;
+  sr.ntp_seconds = 100;
+  sr.ntp_fractions = 200;
+  sr.rtp_timestamp = 123456;
+  sr.packet_count = 12;
+  sr.octet_count = 3456;
+  ok &= Check(webrtc_qos::BuildRtcpSenderReport(sr, &bytes), "build SR");
+  webrtc_qos::RtcpAdapterSenderReport parsed_sr;
+  ok &= Check(webrtc_qos::ParseRtcpSenderReport(bytes.data(), bytes.size(),
+                                                &parsed_sr),
+              "parse SR");
+  ok &= Check(parsed_sr.rtp_timestamp == sr.rtp_timestamp &&
+                  parsed_sr.packet_count == sr.packet_count,
+              "SR roundtrip");
+
+  webrtc_qos::RtcpAdapterTransportFeedback twcc;
+  twcc.sender_ssrc = 0x11111111;
+  twcc.media_ssrc = 0x22222222;
+  twcc.base_sequence = 1000;
+  twcc.base_time_us = 5000000;
+  twcc.feedback_sequence = 9;
+  twcc.packets.push_back({1000, 0});
+  twcc.packets.push_back({1002, 1000});
+  ok &= Check(webrtc_qos::BuildRtcpTransportFeedback(twcc, &bytes),
+              "build TWCC");
+  webrtc_qos::RtcpAdapterTransportFeedback parsed_twcc;
+  ok &= Check(webrtc_qos::ParseRtcpTransportFeedback(bytes.data(),
+                                                     bytes.size(),
+                                                     &parsed_twcc),
+              "parse TWCC");
+  bool has_missing_1001 = false;
+  bool has_received_1002 = false;
+  for (const auto& packet : parsed_twcc.packets) {
+    if (packet.sequence_number == 1001 && packet.delta_since_base_us < 0) {
+      has_missing_1001 = true;
+    }
+    if (packet.sequence_number == 1002 && packet.delta_since_base_us >= 0) {
+      has_received_1002 = true;
+    }
+  }
+  ok &= Check(parsed_twcc.base_sequence == twcc.base_sequence &&
+                  parsed_twcc.feedback_sequence == twcc.feedback_sequence &&
+                  has_missing_1001 && has_received_1002,
+              "TWCC status vector handles missing packet");
+
+  webrtc_qos::RtcpAdapterParsedPacket parsed_packet;
+  ok &= Check(webrtc_qos::ParseRtcpPacket(bytes.data(), bytes.size(),
+                                          &parsed_packet),
+              "generic parse");
+  ok &= Check(parsed_packet.type ==
+                  webrtc_qos::RtcpAdapterPacketType::kTransportFeedback,
+              "generic parse type");
+
+  if (!ok) {
+    return 1;
+  }
+  std::cout << "rtcp_adapter_smoke passed bytes=" << bytes.size() << "\n";
+  return 0;
+}
diff --git a/sdk_qos/rtp_packet_adapter.cc b/sdk_qos/rtp_packet_adapter.cc
new file mode 100644
index 0000000..20049fd
--- /dev/null
+++ b/sdk_qos/rtp_packet_adapter.cc
@@ -0,0 +1,87 @@
+#include "sdk_qos/rtp_packet_adapter.h"
+
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <vector>
+
+#include "modules/rtp_rtcp/include/rtp_header_extension_map.h"
+#include "modules/rtp_rtcp/source/rtp_header_extensions.h"
+#include "modules/rtp_rtcp/source/rtp_packet.h"
+
+namespace webrtc_qos {
+namespace {
+
+webrtc::RtpHeaderExtensionMap MakeExtensionMap(
+    const RtpPacketAdapterConfig& config) {
+  webrtc::RtpHeaderExtensionMap extensions;
+  if (config.enable_transport_sequence_extension &&
+      config.transport_sequence_extension_id != 0) {
+    extensions.Register<webrtc::TransportSequenceNumber>(
+        config.transport_sequence_extension_id);
+  }
+  return extensions;
+}
+
+}  // namespace
+
+bool BuildRtpPacket(const RtpPacketAdapterBuildInput& input,
+                    const RtpPacketAdapterConfig& config,
+                    std::vector<uint8_t>* out) {
+  if (out == nullptr || input.payload == nullptr || input.payload_size == 0 ||
+      input.payload_type > 0x7f) {
+    return false;
+  }
+  if (input.transport_sequence_number.has_value() &&
+      (!config.enable_transport_sequence_extension ||
+       config.transport_sequence_extension_id == 0)) {
+    return false;
+  }
+
+  webrtc::RtpHeaderExtensionMap extensions = MakeExtensionMap(config);
+  webrtc::RtpPacket packet(&extensions, 12 + 8 + input.payload_size);
+  packet.SetPayloadType(input.payload_type);
+  packet.SetMarker(input.marker);
+  packet.SetSequenceNumber(input.sequence_number);
+  packet.SetTimestamp(input.timestamp);
+  packet.SetSsrc(input.ssrc);
+  if (input.transport_sequence_number.has_value() &&
+      !packet.SetExtension<webrtc::TransportSequenceNumber>(
+          *input.transport_sequence_number)) {
+    return false;
+  }
+  packet.SetPayload(std::span<const uint8_t>(input.payload,
+                                             input.payload_size));
+
+  auto packet_buffer = packet.buffer();
+  out->assign(packet_buffer.begin(), packet_buffer.end());
+  return true;
+}
+
+bool ParseRtpPacket(const uint8_t* data,
+                    size_t size,
+                    const RtpPacketAdapterConfig& config,
+                    RtpPacketAdapterParsedPacket* out) {
+  if (data == nullptr || size == 0 || out == nullptr) {
+    return false;
+  }
+
+  webrtc::RtpHeaderExtensionMap extensions = MakeExtensionMap(config);
+  webrtc::RtpPacket packet(&extensions);
+  if (!packet.Parse(data, size)) {
+    return false;
+  }
+
+  out->payload_type = packet.PayloadType();
+  out->marker = packet.Marker();
+  out->sequence_number = packet.SequenceNumber();
+  out->timestamp = packet.Timestamp();
+  out->ssrc = packet.Ssrc();
+  out->transport_sequence_number =
+      packet.GetExtension<webrtc::TransportSequenceNumber>();
+  auto payload = packet.payload();
+  out->payload.assign(payload.begin(), payload.end());
+  return true;
+}
+
+}  // namespace webrtc_qos
