diff --git a/sdk_qos/h264_rtp_adapter.cc b/sdk_qos/h264_rtp_adapter.cc
new file mode 100644
index 0000000..5fb3049
--- /dev/null
+++ b/sdk_qos/h264_rtp_adapter.cc
@@ -0,0 +1,131 @@
+#include "sdk_qos/h264_rtp_adapter.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <utility>
+#include <variant>
+#include <vector>
+
+#include "common_video/h264/h264_common.h"
+#include "modules/rtp_rtcp/source/rtp_format.h"
+#include "modules/rtp_rtcp/source/rtp_format_h264.h"
+#include "modules/rtp_rtcp/source/rtp_packet_to_send.h"
+#include "modules/rtp_rtcp/source/video_rtp_depacketizer_h264.h"
+#include "modules/video_coding/codecs/h264/include/h264_globals.h"
+#include "rtc_base/copy_on_write_buffer.h"
+
+namespace webrtc_qos {
+namespace {
+
+bool IsKeyframeNalu(std::span<const uint8_t> nalu) {
+  return !nalu.empty() &&
+         (nalu[0] & webrtc::kH264TypeMask) == webrtc::H264::NaluType::kIdr;
+}
+
+void AppendAnnexBNalu(std::span<const uint8_t> nalu,
+                      std::vector<uint8_t>* out) {
+  out->push_back(0x00);
+  out->push_back(0x00);
+  out->push_back(0x00);
+  out->push_back(0x01);
+  out->insert(out->end(), nalu.begin(), nalu.end());
+}
+
+}  // namespace
+
+bool PacketizeH264AnnexB(const uint8_t* annexb_access_unit,
+                         size_t annexb_access_unit_size,
+                         const H264RtpPacketizerConfig& config,
+                         std::vector<H264RtpPayload>* out) {
+  if (!annexb_access_unit || !out || annexb_access_unit_size == 0 ||
+      config.max_payload_size < 3) {
+    return false;
+  }
+
+  out->clear();
+  const std::span<const uint8_t> au(annexb_access_unit,
+                                   annexb_access_unit_size);
+  const std::vector<webrtc::H264::NaluIndex> nalu_indices =
+      webrtc::H264::FindNaluIndices(au);
+  if (nalu_indices.empty()) {
+    return false;
+  }
+
+  bool keyframe = false;
+  std::vector<std::span<const uint8_t>> nalus;
+  nalus.reserve(nalu_indices.size());
+  for (const webrtc::H264::NaluIndex& index : nalu_indices) {
+    if (index.payload_size == 0) {
+      return false;
+    }
+    std::span<const uint8_t> nalu =
+        au.subspan(index.payload_start_offset, index.payload_size);
+    nalus.push_back(nalu);
+    keyframe = keyframe || IsKeyframeNalu(nalu);
+  }
+
+  webrtc::RtpPacketizer::PayloadSizeLimits limits;
+  limits.max_payload_len = static_cast<int>(config.max_payload_size);
+  for (size_t i = 0; i < nalus.size(); ++i) {
+    std::vector<uint8_t> single_nalu_annexb;
+    AppendAnnexBNalu(nalus[i], &single_nalu_annexb);
+
+    webrtc::RtpPacketizerH264 packetizer(
+        single_nalu_annexb, limits,
+        webrtc::H264PacketizationMode::NonInterleaved);
+
+    while (packetizer.NumPackets() > 0) {
+      webrtc::RtpPacketToSend packet(nullptr, config.max_payload_size + 64);
+      if (!packetizer.NextPacket(&packet)) {
+        return false;
+      }
+      H264RtpPayload payload;
+      payload.marker = false;
+      payload.first_packet_in_frame = out->empty();
+      payload.keyframe = keyframe;
+      std::span<const uint8_t> packet_payload = packet.payload();
+      payload.payload.assign(packet_payload.begin(), packet_payload.end());
+      out->push_back(std::move(payload));
+    }
+  }
+
+  if (out->empty()) {
+    return false;
+  }
+  out->back().marker = true;
+  return true;
+}
+
+bool DepacketizeH264Payload(const uint8_t* rtp_payload,
+                            size_t rtp_payload_size,
+                            H264DepacketizedPayload* out) {
+  if (!rtp_payload || rtp_payload_size == 0 || !out) {
+    return false;
+  }
+
+  webrtc::VideoRtpDepacketizerH264 depacketizer;
+  webrtc::CopyOnWriteBuffer payload(rtp_payload, rtp_payload_size);
+  auto parsed = depacketizer.Parse(std::move(payload));
+  if (!parsed.has_value()) {
+    return false;
+  }
+
+  *out = H264DepacketizedPayload{};
+  out->first_packet_in_frame =
+      parsed->video_header.is_first_packet_in_frame;
+  out->keyframe =
+      parsed->video_header.frame_type == webrtc::VideoFrameType::kVideoFrameKey;
+  if (std::holds_alternative<webrtc::RTPVideoHeaderH264>(
+          parsed->video_header.video_type_header)) {
+    const auto& h264 = std::get<webrtc::RTPVideoHeaderH264>(
+        parsed->video_header.video_type_header);
+    out->nalu_type = h264.nalu_type;
+  }
+  out->valid = true;
+  std::span<const uint8_t> video_payload(parsed->video_payload);
+  out->video_payload.assign(video_payload.begin(), video_payload.end());
+  return true;
+}
+
+}  // namespace webrtc_qos
