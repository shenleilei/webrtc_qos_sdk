diff --git a/sdk_qos/nack_requester_adapter_smoke.cc b/sdk_qos/nack_requester_adapter_smoke.cc
new file mode 100644
index 0000000..a092152
--- /dev/null
+++ b/sdk_qos/nack_requester_adapter_smoke.cc
@@ -0,0 +1,53 @@
+#include <cstdint>
+#include <iostream>
+
+#include "sdk_qos/nack_requester_adapter.h"
+
+namespace {
+
+bool Check(bool condition, const char* message) {
+  if (!condition) {
+    std::cerr << "FAIL: " << message << "\n";
+    return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+int main() {
+  webrtc_qos::NackRequesterAdapter adapter({20});
+  bool ok = true;
+
+  adapter.OnReceivedPacket(1, false);
+  adapter.OnReceivedPacket(3, false);
+  auto events = adapter.DrainEvents();
+  ok &= Check(events.size() == 1, "single missing packet produces NACK event");
+  ok &= Check(events[0].type == webrtc_qos::NackRequesterAdapterEventType::kNack,
+              "event type is nack");
+  ok &= Check(events[0].rtp_sequence_numbers.size() == 1,
+              "one nack sequence emitted");
+  ok &= Check(events[0].rtp_sequence_numbers[0] == 2,
+              "missing sequence number is nacked");
+
+  adapter.OnReceivedPacket(6, false);
+  events = adapter.DrainEvents();
+  ok &= Check(events.size() == 1, "gap produces batched NACK event");
+  ok &= Check(events[0].rtp_sequence_numbers.size() == 2,
+              "two missing packets are nacked");
+  ok &= Check(events[0].rtp_sequence_numbers[0] == 4 &&
+                  events[0].rtp_sequence_numbers[1] == 5,
+              "batched nack sequence numbers");
+
+  adapter.ClearUpTo(6);
+  adapter.ProcessNacks();
+  events = adapter.DrainEvents();
+  ok &= Check(events.empty(), "clear removes pending NACKs");
+
+  if (!ok) {
+    return 1;
+  }
+
+  std::cout << "nack_requester_adapter_smoke passed\n";
+  return 0;
+}
diff --git a/sdk_qos/pacing_adapter.cc b/sdk_qos/pacing_adapter.cc
new file mode 100644
index 0000000..85377c4
--- /dev/null
+++ b/sdk_qos/pacing_adapter.cc
@@ -0,0 +1,472 @@
+#include "sdk_qos/pacing_adapter.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <optional>
+#include <span>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "api/field_trials_view.h"
+#include "api/transport/network_types.h"
+#include "api/units/data_rate.h"
+#include "api/units/data_size.h"
+#include "api/units/time_delta.h"
+#include "api/units/timestamp.h"
+#include "modules/pacing/pacing_controller.h"
+#include "modules/rtp_rtcp/include/rtp_header_extension_map.h"
+#include "modules/rtp_rtcp/include/rtp_rtcp_defines.h"
+#include "modules/rtp_rtcp/source/rtp_header_extensions.h"
+#include "modules/rtp_rtcp/source/rtp_packet_to_send.h"
+#include "system_wrappers/include/clock.h"
+
+namespace webrtc_qos {
+namespace {
+
+class EmptyFieldTrials final : public webrtc::FieldTrialsView {
+ public:
+  std::string Lookup(absl::string_view) const override { return std::string(); }
+};
+
+class CollectingPacketSender final
+    : public webrtc::PacingController::PacketSender {
+ public:
+  explicit CollectingPacketSender(uint8_t transport_sequence_extension_id) {
+    if (transport_sequence_extension_id != 0) {
+      extensions_.Register<webrtc::TransportSequenceNumber>(
+          transport_sequence_extension_id);
+    }
+  }
+
+  void SetPaddingTemplate(const webrtc::RtpPacketToSend& packet,
+                          uint16_t next_sequence_number,
+                          uint16_t next_transport_sequence_number) {
+    padding_template_ = std::make_unique<webrtc::RtpPacketToSend>(&extensions_);
+    padding_template_->CopyHeaderFrom(packet);
+    padding_template_->IdentifyExtensions(extensions_);
+    padding_template_->SetPayloadSize(0);
+    next_padding_sequence_number_ = next_sequence_number;
+    next_padding_transport_sequence_number_ = next_transport_sequence_number;
+  }
+
+  void ReservePaddingSequenceRange(uint16_t next_sequence_number,
+                                   uint16_t next_transport_sequence_number) {
+    if (!padding_template_) {
+      return;
+    }
+    next_padding_sequence_number_ = next_sequence_number;
+    next_padding_transport_sequence_number_ = next_transport_sequence_number;
+  }
+
+  uint16_t next_padding_sequence_number() const {
+    return next_padding_sequence_number_;
+  }
+
+  uint16_t next_padding_transport_sequence_number() const {
+    return next_padding_transport_sequence_number_;
+  }
+
+  void SendPacket(std::unique_ptr<webrtc::RtpPacketToSend> packet,
+                  const webrtc::PacedPacketInfo& cluster_info) override {
+    SentPacket sent;
+    sent.packet = std::move(packet);
+    sent.cluster_info = cluster_info;
+    sent_packets_.push_back(std::move(sent));
+  }
+
+  std::vector<std::unique_ptr<webrtc::RtpPacketToSend>> FetchFec() override {
+    return {};
+  }
+
+  std::vector<std::unique_ptr<webrtc::RtpPacketToSend>> GeneratePadding(
+      webrtc::DataSize size) override {
+    std::vector<std::unique_ptr<webrtc::RtpPacketToSend>> padding_packets;
+    if (!padding_template_ || size <= webrtc::DataSize::Bytes(1)) {
+      return padding_packets;
+    }
+
+    webrtc::DataSize generated = webrtc::DataSize::Zero();
+    while (generated < size) {
+      const size_t remaining =
+          static_cast<size_t>((size - generated).bytes());
+      const size_t padding_size = std::min<size_t>(remaining, 224);
+      auto padding =
+          std::make_unique<webrtc::RtpPacketToSend>(*padding_template_);
+      padding->SetMarker(false);
+      padding->SetSequenceNumber(next_padding_sequence_number_++);
+      padding->set_transport_sequence_number(
+          next_padding_transport_sequence_number_);
+      padding->SetExtension<webrtc::TransportSequenceNumber>(
+          next_padding_transport_sequence_number_++);
+      padding->set_packet_type(webrtc::RtpPacketMediaType::kPadding);
+      padding->set_is_key_frame(false);
+      padding->set_first_packet_of_frame(false);
+      padding->SetPayloadSize(0);
+      if (!padding->SetPadding(padding_size)) {
+        break;
+      }
+      generated += webrtc::DataSize::Bytes(padding->padding_size());
+      padding_packets.push_back(std::move(padding));
+    }
+    return padding_packets;
+  }
+
+  struct SentPacket {
+    std::unique_ptr<webrtc::RtpPacketToSend> packet;
+    webrtc::PacedPacketInfo cluster_info;
+  };
+
+  std::vector<SentPacket> TakeSentPackets() {
+    std::vector<SentPacket> out;
+    out.swap(sent_packets_);
+    return out;
+  }
+
+ private:
+  std::vector<SentPacket> sent_packets_;
+  webrtc::RtpHeaderExtensionMap extensions_;
+  std::unique_ptr<webrtc::RtpPacketToSend> padding_template_;
+  uint16_t next_padding_sequence_number_ = 0;
+  uint16_t next_padding_transport_sequence_number_ = 0;
+};
+
+uint32_t ExpectedQueueTimeMs(size_t bytes, uint32_t pacing_bitrate_bps) {
+  if (bytes == 0 || pacing_bitrate_bps == 0) {
+    return 0;
+  }
+  const uint64_t bits = static_cast<uint64_t>(bytes) * 8 * 1000;
+  return static_cast<uint32_t>(bits / pacing_bitrate_bps);
+}
+
+std::unique_ptr<webrtc::RtpPacketToSend> MakeWebRtcPacket(
+    const PacingAdapterPacket& packet) {
+  if (packet.bytes.empty()) {
+    return nullptr;
+  }
+  auto rtp_packet = std::make_unique<webrtc::RtpPacketToSend>(nullptr);
+  if (!rtp_packet->Parse(packet.bytes.data(), packet.bytes.size())) {
+    return nullptr;
+  }
+  rtp_packet->set_capture_time(
+      webrtc::Timestamp::Micros(std::max<int64_t>(0, packet.enqueue_time_us)));
+  rtp_packet->set_transport_sequence_number(packet.transport_sequence_number);
+  rtp_packet->set_is_key_frame(packet.keyframe);
+  rtp_packet->set_first_packet_of_frame(packet.keyframe);
+  if (packet.retransmission) {
+    rtp_packet->set_packet_type(webrtc::RtpPacketMediaType::kVideo);
+    rtp_packet->set_packet_type(webrtc::RtpPacketMediaType::kRetransmission);
+    rtp_packet->set_retransmitted_sequence_number(packet.rtp_sequence_number);
+    rtp_packet->set_original_ssrc(packet.ssrc);
+  } else {
+    rtp_packet->set_packet_type(webrtc::RtpPacketMediaType::kVideo);
+  }
+  return rtp_packet;
+}
+
+PacingAdapterPacket MakeAdapterPacket(
+    std::unique_ptr<webrtc::RtpPacketToSend> packet,
+    const webrtc::PacedPacketInfo& cluster_info,
+    bool fallback_retransmission,
+    bool fallback_keyframe) {
+  PacingAdapterPacket out;
+  out.ssrc = packet->Ssrc();
+  out.rtp_sequence_number = packet->SequenceNumber();
+  out.transport_sequence_number =
+      packet->transport_sequence_number().value_or(-1);
+  out.enqueue_time_us = packet->capture_time().us();
+  out.retransmission = packet->packet_type() ==
+                       webrtc::RtpPacketMediaType::kRetransmission;
+  out.padding =
+      packet->packet_type() == webrtc::RtpPacketMediaType::kPadding ||
+      packet->padding_size() > 0;
+  out.keyframe = packet->is_key_frame() || fallback_keyframe;
+  out.probe_cluster_id = cluster_info.probe_cluster_id;
+  if (!out.retransmission) {
+    out.retransmission = fallback_retransmission;
+  }
+  auto buffer = packet->buffer();
+  out.bytes.assign(buffer.begin(), buffer.end());
+  return out;
+}
+
+}  // namespace
+
+class PacingAdapter::Impl {
+ public:
+  explicit Impl(const PacingAdapterConfig& config)
+      : config_(config),
+        clock_(webrtc::Timestamp::Zero()),
+        packet_sender_(config.transport_sequence_extension_id) {
+    webrtc::PacingController::Configuration controller_config =
+        webrtc::PacingController::DefaultConfiguration();
+    controller_config.queue_time_limit =
+        webrtc::TimeDelta::Millis(config_.max_queue_time_ms > 0
+                                      ? config_.max_queue_time_ms
+                                      : 500);
+    controller_config.prioritize_audio_retransmission = true;
+    controller_ = std::make_unique<webrtc::PacingController>(
+        &clock_, &packet_sender_, field_trials_, controller_config);
+    controller_->SetPacerConfig(webrtc::PacerConfig::Create(
+        webrtc::Timestamp::Zero(),
+        webrtc::DataRate::BitsPerSec(std::max<uint32_t>(1, config_.pacing_bitrate_bps)),
+        webrtc::DataRate::BitsPerSec(config_.padding_bitrate_bps),
+        webrtc::TimeDelta::Millis(5)));
+    controller_->SetAllowProbeWithoutMediaPacket(true);
+    stats_.pacing_bitrate_bps = config_.pacing_bitrate_bps;
+  }
+
+  void SetRates(uint32_t pacing_bitrate_bps, uint32_t padding_bitrate_bps) {
+    config_.pacing_bitrate_bps = pacing_bitrate_bps;
+    config_.padding_bitrate_bps = padding_bitrate_bps;
+    controller_->SetPacerConfig(webrtc::PacerConfig::Create(
+        clock_.CurrentTime(),
+        webrtc::DataRate::BitsPerSec(std::max<uint32_t>(1, pacing_bitrate_bps)),
+        webrtc::DataRate::BitsPerSec(padding_bitrate_bps),
+        webrtc::TimeDelta::Millis(5)));
+    stats_.pacing_bitrate_bps = pacing_bitrate_bps;
+  }
+
+  void SetProbeCluster(const PacingAdapterProbeCluster& probe_cluster) {
+    probe_cluster_ = probe_cluster;
+    probe_packets_emitted_ = 0;
+    probe_bytes_emitted_ = 0;
+    if (probe_cluster.id >= 0 && probe_cluster.target_bitrate_bps > 0) {
+      webrtc::ProbeClusterConfig config;
+      config.at_time = clock_.CurrentTime();
+      config.target_data_rate =
+          webrtc::DataRate::BitsPerSec(probe_cluster.target_bitrate_bps);
+      config.target_duration = webrtc::TimeDelta::Micros(
+          probe_cluster.target_duration_us > 0 ? probe_cluster.target_duration_us
+                                               : 15000);
+      config.min_probe_delta = webrtc::TimeDelta::Micros(
+          probe_cluster.min_probe_delta_us > 0 ? probe_cluster.min_probe_delta_us
+                                               : 1000);
+      config.target_probe_count =
+          static_cast<int>(std::max<uint32_t>(1, probe_cluster.min_probe_count));
+      config.id = probe_cluster.id;
+      controller_->CreateProbeClusters(std::span<const webrtc::ProbeClusterConfig>(&config, 1));
+      stats_.last_probe_cluster_id = probe_cluster.id;
+    }
+  }
+
+  void ClearProbeCluster() {
+    probe_cluster_.id = -1;
+    probe_packets_emitted_ = 0;
+    probe_bytes_emitted_ = 0;
+  }
+
+  bool EnqueuePacket(const PacingAdapterPacket& packet) {
+    const size_t packet_size = packet.bytes.size();
+    if (packet_size == 0) {
+      return false;
+    }
+    if (queue_bytes_ + packet_size > config_.max_queue_bytes) {
+      ++stats_.dropped_packets;
+      return false;
+    }
+    if (config_.max_queue_time_ms > 0 &&
+        ExpectedQueueTimeMs(queue_bytes_ + packet_size,
+                            std::max<uint32_t>(1, config_.pacing_bitrate_bps)) >
+            config_.max_queue_time_ms) {
+      ++stats_.dropped_packets;
+      return false;
+    }
+    std::unique_ptr<webrtc::RtpPacketToSend> rtp_packet = MakeWebRtcPacket(packet);
+    if (!rtp_packet) {
+      ++stats_.dropped_packets;
+      return false;
+    }
+    QueuedMetadata metadata;
+    metadata.ssrc = packet.ssrc;
+    metadata.rtp_sequence_number = packet.rtp_sequence_number;
+    metadata.retransmission = packet.retransmission;
+    metadata.keyframe = packet.keyframe;
+    metadata.bytes = packet_size;
+    queued_metadata_.push_back(metadata);
+    queue_bytes_ += packet_size;
+    padding_sequence_floor_ =
+        static_cast<uint16_t>(packet.rtp_sequence_number + 1);
+    if (packet.transport_sequence_number >= 0) {
+      padding_transport_sequence_floor_ =
+          static_cast<uint16_t>(packet.transport_sequence_number + 1);
+    }
+    packet_sender_.SetPaddingTemplate(*rtp_packet, padding_sequence_floor_,
+                                      padding_transport_sequence_floor_);
+    controller_->EnqueuePacket(std::move(rtp_packet));
+    UpdateStats();
+    return true;
+  }
+
+  std::vector<PacingAdapterPacket> Process(int64_t now_us) {
+    AdvanceClock(now_us);
+    controller_->ProcessPackets();
+    std::vector<PacingAdapterPacket> emitted;
+    for (auto& sent : packet_sender_.TakeSentPackets()) {
+      QueuedMetadata metadata = PopMetadata(*sent.packet);
+      PacingAdapterPacket packet = MakeAdapterPacket(
+          std::move(sent.packet), sent.cluster_info, metadata.retransmission,
+          metadata.keyframe);
+      if (queue_bytes_ >= metadata.bytes) {
+        queue_bytes_ -= metadata.bytes;
+      } else {
+        queue_bytes_ = 0;
+      }
+      ++stats_.emitted_packets;
+      if (packet.retransmission) {
+        ++stats_.emitted_retransmissions;
+      }
+      if (packet.padding) {
+        ++stats_.emitted_padding_packets;
+        stats_.emitted_padding_bytes += packet.bytes.size();
+        padding_sequence_floor_ =
+            static_cast<uint16_t>(packet.rtp_sequence_number + 1);
+        if (packet.transport_sequence_number >= 0) {
+          padding_transport_sequence_floor_ =
+              static_cast<uint16_t>(packet.transport_sequence_number + 1);
+        }
+      }
+      if (packet.keyframe) {
+        ++stats_.emitted_keyframe_packets;
+      }
+      if (packet.probe_cluster_id != webrtc::PacedPacketInfo::kNotAProbe) {
+        ++stats_.emitted_probe_packets;
+        stats_.emitted_probe_bytes += packet.bytes.size();
+        stats_.last_probe_cluster_id = packet.probe_cluster_id;
+        ++probe_packets_emitted_;
+        probe_bytes_emitted_ += packet.bytes.size();
+        MaybeCompleteProbeCluster();
+      }
+      emitted.push_back(std::move(packet));
+    }
+    packet_sender_.ReservePaddingSequenceRange(
+        padding_sequence_floor_, padding_transport_sequence_floor_);
+    UpdateStats();
+    return emitted;
+  }
+
+  PacingAdapterStats stats() const {
+    PacingAdapterStats out = stats_;
+    out.queue_packets = static_cast<size_t>(std::max<int>(0, controller_->QueueSizePackets()));
+    out.queue_bytes = queue_bytes_;
+    out.expected_queue_time_ms = ExpectedQueueTimeMs(
+        queue_bytes_, std::max<uint32_t>(1, config_.pacing_bitrate_bps));
+    return out;
+  }
+
+ private:
+  struct QueuedMetadata {
+    uint32_t ssrc = 0;
+    uint16_t rtp_sequence_number = 0;
+    bool retransmission = false;
+    bool keyframe = false;
+    size_t bytes = 0;
+  };
+
+  void AdvanceClock(int64_t now_us) {
+    if (now_us < 0) {
+      now_us = 0;
+    }
+    const int64_t current_us = clock_.CurrentTime().us();
+    if (now_us > current_us) {
+      clock_.AdvanceTimeMicroseconds(now_us - current_us);
+    }
+  }
+
+  QueuedMetadata PopMetadata(const webrtc::RtpPacketToSend& packet) {
+    for (auto it = queued_metadata_.begin(); it != queued_metadata_.end(); ++it) {
+      if (it->ssrc == packet.Ssrc() &&
+          it->rtp_sequence_number == packet.SequenceNumber()) {
+        QueuedMetadata metadata = *it;
+        queued_metadata_.erase(it);
+        return metadata;
+      }
+    }
+    QueuedMetadata metadata;
+    metadata.ssrc = packet.Ssrc();
+    metadata.rtp_sequence_number = packet.SequenceNumber();
+    metadata.retransmission =
+        packet.packet_type() == webrtc::RtpPacketMediaType::kRetransmission;
+    metadata.keyframe = packet.is_key_frame();
+    metadata.bytes = packet.size();
+    return metadata;
+  }
+
+  void MaybeCompleteProbeCluster() {
+    if (probe_cluster_.id < 0) {
+      return;
+    }
+    const bool enough_packets = probe_cluster_.min_probe_count == 0 ||
+                                probe_packets_emitted_ >= probe_cluster_.min_probe_count;
+    const bool enough_bytes = probe_cluster_.min_probe_bytes == 0 ||
+                              probe_bytes_emitted_ >= probe_cluster_.min_probe_bytes;
+    if (enough_packets && enough_bytes) {
+      ClearProbeCluster();
+    }
+  }
+
+  void UpdateStats() {
+    stats_.queue_packets = static_cast<size_t>(std::max<int>(0, controller_->QueueSizePackets()));
+    stats_.queue_bytes = queue_bytes_;
+    stats_.expected_queue_time_ms = ExpectedQueueTimeMs(
+        queue_bytes_, std::max<uint32_t>(1, config_.pacing_bitrate_bps));
+  }
+
+  PacingAdapterConfig config_;
+  EmptyFieldTrials field_trials_;
+  webrtc::SimulatedClock clock_;
+  CollectingPacketSender packet_sender_;
+  std::unique_ptr<webrtc::PacingController> controller_;
+  PacingAdapterProbeCluster probe_cluster_;
+  uint32_t probe_packets_emitted_ = 0;
+  uint32_t probe_bytes_emitted_ = 0;
+  uint16_t padding_sequence_floor_ = 1;
+  uint16_t padding_transport_sequence_floor_ = 1;
+  std::deque<QueuedMetadata> queued_metadata_;
+  size_t queue_bytes_ = 0;
+  PacingAdapterStats stats_;
+};
+
+PacingAdapter::PacingAdapter(const PacingAdapterConfig& config)
+    : impl_(std::make_unique<Impl>(config)) {}
+
+PacingAdapter::~PacingAdapter() = default;
+
+void PacingAdapter::SetRates(uint32_t pacing_bitrate_bps,
+                             uint32_t padding_bitrate_bps) {
+  impl_->SetRates(pacing_bitrate_bps, padding_bitrate_bps);
+}
+
+void PacingAdapter::SetProbeCluster(
+    const PacingAdapterProbeCluster& probe_cluster) {
+  impl_->SetProbeCluster(probe_cluster);
+}
+
+void PacingAdapter::ClearProbeCluster() {
+  impl_->ClearProbeCluster();
+}
+
+bool PacingAdapter::EnqueuePacket(const PacingAdapterPacket& packet) {
+  return impl_->EnqueuePacket(packet);
+}
+
+std::vector<PacingAdapterPacket> PacingAdapter::Process(int64_t now_us) {
+  return impl_->Process(now_us);
+}
+
+PacingAdapterStats PacingAdapter::stats() const {
+  return impl_->stats();
+}
+
+PacingAdapter* CreatePacingAdapter(const PacingAdapterConfig& config) {
+  return new PacingAdapter(config);
+}
+
+void DestroyPacingAdapter(PacingAdapter* adapter) {
+  delete adapter;
+}
+
+}  // namespace webrtc_qos
diff --git a/sdk_qos/pacing_adapter.h b/sdk_qos/pacing_adapter.h
new file mode 100644
index 0000000..cc266c2
--- /dev/null
+++ b/sdk_qos/pacing_adapter.h
@@ -0,0 +1,81 @@
+#ifndef SDK_QOS_PACING_ADAPTER_H_
+#define SDK_QOS_PACING_ADAPTER_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+namespace webrtc_qos {
+
+struct PacingAdapterConfig {
+  uint32_t pacing_bitrate_bps = 1200000;
+  uint32_t padding_bitrate_bps = 0;
+  uint32_t max_queue_bytes = 512 * 1024;
+  uint32_t max_queue_time_ms = 500;
+  uint8_t transport_sequence_extension_id = 1;
+};
+
+struct PacingAdapterProbeCluster {
+  int32_t id = -1;
+  uint32_t target_bitrate_bps = 0;
+  uint32_t min_probe_count = 0;
+  uint32_t min_probe_bytes = 0;
+  uint32_t target_duration_us = 0;
+  uint32_t min_probe_delta_us = 0;
+};
+
+struct PacingAdapterPacket {
+  uint32_t ssrc = 0;
+  uint16_t rtp_sequence_number = 0;
+  int64_t transport_sequence_number = -1;
+  int64_t enqueue_time_us = 0;
+  bool retransmission = false;
+  bool keyframe = false;
+  bool padding = false;
+  int32_t probe_cluster_id = -1;
+  std::vector<uint8_t> bytes;
+};
+
+struct PacingAdapterStats {
+  uint32_t pacing_bitrate_bps = 0;
+  size_t queue_packets = 0;
+  size_t queue_bytes = 0;
+  uint32_t expected_queue_time_ms = 0;
+  uint64_t emitted_packets = 0;
+  uint64_t dropped_packets = 0;
+  uint64_t emitted_retransmissions = 0;
+  uint64_t emitted_keyframe_packets = 0;
+  uint64_t emitted_probe_packets = 0;
+  uint64_t emitted_probe_bytes = 0;
+  uint64_t emitted_padding_packets = 0;
+  uint64_t emitted_padding_bytes = 0;
+  int32_t last_probe_cluster_id = -1;
+};
+
+class PacingAdapter {
+ public:
+  explicit PacingAdapter(const PacingAdapterConfig& config);
+  ~PacingAdapter();
+
+  PacingAdapter(const PacingAdapter&) = delete;
+  PacingAdapter& operator=(const PacingAdapter&) = delete;
+
+  void SetRates(uint32_t pacing_bitrate_bps, uint32_t padding_bitrate_bps);
+  void SetProbeCluster(const PacingAdapterProbeCluster& probe_cluster);
+  void ClearProbeCluster();
+  bool EnqueuePacket(const PacingAdapterPacket& packet);
+  std::vector<PacingAdapterPacket> Process(int64_t now_us);
+  PacingAdapterStats stats() const;
+
+ private:
+  class Impl;
+  std::unique_ptr<Impl> impl_;
+};
+
+PacingAdapter* CreatePacingAdapter(const PacingAdapterConfig& config);
+void DestroyPacingAdapter(PacingAdapter* adapter);
+
+}  // namespace webrtc_qos
+
+#endif  // SDK_QOS_PACING_ADAPTER_H_
diff --git a/sdk_qos/pacing_adapter_smoke.cc b/sdk_qos/pacing_adapter_smoke.cc
new file mode 100644
index 0000000..ee36687
--- /dev/null
+++ b/sdk_qos/pacing_adapter_smoke.cc
@@ -0,0 +1,153 @@
+#include <cstdint>
+#include <iostream>
+#include <vector>
+
+#include "sdk_qos/pacing_adapter.h"
+
+namespace {
+
+bool Check(bool condition, const char* message) {
+  if (!condition) {
+    std::cerr << "FAIL: " << message << "\n";
+    return false;
+  }
+  return true;
+}
+
+webrtc_qos::PacingAdapterPacket MakePacket(uint16_t seq,
+                                           size_t bytes,
+                                           bool retransmission) {
+  const size_t payload_size = bytes > 12 ? bytes - 12 : 1;
+  webrtc_qos::PacingAdapterPacket packet;
+  packet.ssrc = 0x12345678;
+  packet.rtp_sequence_number = seq;
+  packet.transport_sequence_number = seq;
+  packet.enqueue_time_us = 0;
+  packet.retransmission = retransmission;
+  packet.keyframe = seq == 7;
+  packet.bytes.assign(12 + payload_size, 0);
+  packet.bytes[0] = 0x80;
+  packet.bytes[1] = 96;
+  packet.bytes[2] = static_cast<uint8_t>(seq >> 8);
+  packet.bytes[3] = static_cast<uint8_t>(seq & 0xff);
+  const uint32_t timestamp = 90000 + seq * 3000;
+  packet.bytes[4] = static_cast<uint8_t>(timestamp >> 24);
+  packet.bytes[5] = static_cast<uint8_t>(timestamp >> 16);
+  packet.bytes[6] = static_cast<uint8_t>(timestamp >> 8);
+  packet.bytes[7] = static_cast<uint8_t>(timestamp);
+  packet.bytes[8] = 0x12;
+  packet.bytes[9] = 0x34;
+  packet.bytes[10] = 0x56;
+  packet.bytes[11] = 0x78;
+  std::fill(packet.bytes.begin() + 12, packet.bytes.end(),
+            static_cast<uint8_t>(seq & 0xff));
+  return packet;
+}
+
+}  // namespace
+
+int main() {
+  webrtc_qos::PacingAdapter adapter(
+      webrtc_qos::PacingAdapterConfig{800000, 0, 4096, 500});
+  bool ok = true;
+
+  adapter.Process(0);
+  ok &= Check(adapter.EnqueuePacket(MakePacket(1, 400, false)),
+              "enqueue media 1");
+  ok &= Check(adapter.EnqueuePacket(MakePacket(2, 400, false)),
+              "enqueue media 2");
+  ok &= Check(adapter.EnqueuePacket(MakePacket(3, 300, true)),
+              "enqueue retransmission");
+
+  auto emitted = adapter.Process(10000);
+  ok &= Check(emitted.size() == 3, "emits through WebRTC PacingController");
+  ok &= Check(emitted[0].retransmission, "retransmission priority");
+  ok &= Check(adapter.stats().queue_packets == 0, "queue drained");
+
+  adapter.SetRates(1600000, 0);
+  emitted = adapter.Process(20000);
+  ok &= Check(emitted.empty(), "no duplicate sends after queue drained");
+
+  webrtc_qos::PacingAdapter tiny(
+      webrtc_qos::PacingAdapterConfig{800000, 0, 512, 500});
+  ok &= Check(tiny.EnqueuePacket(MakePacket(4, 400, false)),
+              "tiny enqueue first");
+  ok &= Check(!tiny.EnqueuePacket(MakePacket(5, 400, false)),
+              "tiny drops over queue limit");
+
+  webrtc_qos::PacingAdapter short_queue(
+      webrtc_qos::PacingAdapterConfig{800000, 0, 4096, 5});
+  ok &= Check(!short_queue.EnqueuePacket(MakePacket(6, 800, false)),
+              "drops over queue time limit");
+
+  webrtc_qos::PacingAdapter probe(
+      webrtc_qos::PacingAdapterConfig{800000, 0, 8192, 500});
+  probe.Process(0);
+  probe.SetProbeCluster(
+      webrtc_qos::PacingAdapterProbeCluster{101, 2400000, 2, 800, 20000, 1000});
+  ok &= Check(probe.EnqueuePacket(MakePacket(7, 400, false)),
+              "probe enqueue keyframe packet");
+  ok &= Check(probe.EnqueuePacket(MakePacket(8, 400, false)),
+              "probe enqueue media packet");
+  emitted = probe.Process(10000);
+  auto second_probe = probe.Process(12000);
+  emitted.insert(emitted.end(), second_probe.begin(), second_probe.end());
+  ok &= Check(emitted.size() >= 1, "probe emits through PacingController");
+  ok &= Check(emitted[0].probe_cluster_id == 101, "probe packet tagged");
+  ok &= Check(emitted[0].keyframe, "keyframe metadata preserved");
+  ok &= Check(probe.stats().emitted_probe_packets == 2,
+              "probe packet stats");
+  ok &= Check(probe.stats().emitted_probe_bytes == 800,
+              "probe byte stats");
+  ok &= Check(probe.stats().last_probe_cluster_id == 101,
+              "last probe cluster stats");
+
+  webrtc_qos::PacingAdapter padding(
+      webrtc_qos::PacingAdapterConfig{800000, 160000, 8192, 500});
+  padding.Process(0);
+  ok &= Check(padding.EnqueuePacket(MakePacket(20, 400, false)),
+              "padding enqueue media template");
+  emitted = padding.Process(10000);
+  ok &= Check(!emitted.empty(), "padding media emitted");
+  emitted = padding.Process(40000);
+  ok &= Check(!emitted.empty(), "padding generated after media");
+  ok &= Check(emitted[0].padding, "padding packet marked");
+  ok &= Check(emitted[0].rtp_sequence_number == 21,
+              "padding uses next RTP sequence");
+  ok &= Check(emitted[0].transport_sequence_number == 21,
+              "padding uses next transport sequence");
+  ok &= Check(emitted[0].bytes.size() >= 13,
+              "padding has RTP header and padding bytes");
+  ok &= Check((emitted[0].bytes[0] & 0x20) != 0,
+              "padding RTP bit set");
+  ok &= Check(padding.stats().emitted_padding_packets >= 1,
+              "padding packet stats");
+  ok &= Check(padding.stats().emitted_padding_bytes >= emitted[0].bytes.size(),
+              "padding byte stats");
+
+  webrtc_qos::PacingAdapter probe_rtx(
+      webrtc_qos::PacingAdapterConfig{800000, 0, 8192, 500});
+  probe_rtx.Process(0);
+  probe_rtx.SetProbeCluster(
+      webrtc_qos::PacingAdapterProbeCluster{102, 2400000, 1, 300, 20000, 1000});
+  ok &= Check(probe_rtx.EnqueuePacket(MakePacket(9, 400, true)),
+              "probe enqueue retransmission");
+  emitted = probe_rtx.Process(10000);
+  ok &= Check(emitted.size() == 1 && emitted[0].retransmission,
+              "probe can use retransmission packet");
+  ok &= Check(probe_rtx.stats().emitted_retransmissions == 1,
+              "retransmission stats");
+
+  if (!ok) {
+    return 1;
+  }
+  std::cout << "pacing_adapter_smoke passed emitted="
+            << adapter.stats().emitted_packets
+            << " probe_emitted=" << probe.stats().emitted_probe_packets
+            << " probe_bytes=" << probe.stats().emitted_probe_bytes
+            << " padding_emitted="
+            << padding.stats().emitted_padding_packets
+            << " padding_bytes=" << padding.stats().emitted_padding_bytes
+            << "\n";
+  return 0;
+}
