@@ -0,0 +1,62 @@
+#include <cstdint>
+#include <iostream>
+#include <vector>
+
+#include "sdk_qos/rtp_packet_adapter.h"
+
+namespace {
+
+bool Check(bool condition, const char* message) {
+  if (!condition) {
+    std::cerr << "FAIL: " << message << "\n";
+    return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+int main() {
+  const std::vector<uint8_t> payload = {0x65, 0x88, 0x99, 0xaa};
+  std::vector<uint8_t> bytes;
+  webrtc_qos::RtpPacketAdapterConfig config;
+  config.payload_type = 96;
+  config.transport_sequence_extension_id = 1;
+  config.enable_transport_sequence_extension = true;
+
+  webrtc_qos::RtpPacketAdapterBuildInput input;
+  input.payload_type = 96;
+  input.marker = true;
+  input.sequence_number = 77;
+  input.timestamp = 90000;
+  input.ssrc = 0x12345678;
+  input.transport_sequence_number = 300;
+  input.payload = payload.data();
+  input.payload_size = payload.size();
+
+  bool ok = true;
+  ok &= Check(webrtc_qos::BuildRtpPacket(input, config, &bytes),
+              "build rtp packet");
+  ok &= Check(bytes.size() > payload.size(), "rtp header exists");
+
+  webrtc_qos::RtpPacketAdapterParsedPacket parsed;
+  ok &= Check(webrtc_qos::ParseRtpPacket(bytes.data(), bytes.size(), config,
+                                         &parsed),
+              "parse rtp packet");
+  ok &= Check(parsed.payload_type == 96, "payload type");
+  ok &= Check(parsed.marker, "marker");
+  ok &= Check(parsed.sequence_number == 77, "rtp sequence");
+  ok &= Check(parsed.timestamp == 90000, "rtp timestamp");
+  ok &= Check(parsed.ssrc == 0x12345678, "ssrc");
+  ok &= Check(parsed.transport_sequence_number.has_value() &&
+                  *parsed.transport_sequence_number == 300,
+              "transport sequence extension");
+  ok &= Check(parsed.payload == payload, "payload bytes");
+
+  if (!ok) {
+    return 1;
+  }
+  std::cout << "rtp_packet_adapter_smoke passed bytes=" << bytes.size()
+            << "\n";
+  return 0;
+}
