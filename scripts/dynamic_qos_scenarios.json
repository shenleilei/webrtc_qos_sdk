[
  {
    "name": "walk_outage_recover",
    "category": "transition",
    "description": "Good network, walking into a coverage hole, then recovering to good network.",
    "phases": [
      {
        "name": "good",
        "bandwidth_kbps": 10000,
        "rtt_ms": 20,
        "loss": 0.0,
        "expect": {
          "encoder_bps_min": 2000000,
          "encoder_bps_max": 2500000,
          "max_fps_min": 30,
          "max_fps_max": 30,
          "keyframe": false
        }
      },
      {
        "name": "outage",
        "bandwidth_kbps": 80,
        "rtt_ms": 1000,
        "loss": 0.45,
        "expect": {
          "encoder_bps_min": 80000,
          "encoder_bps_max": 200000,
          "max_fps_min": 5,
          "max_fps_max": 5,
          "keyframe": true
        }
      },
      {
        "name": "poor",
        "bandwidth_kbps": 120,
        "rtt_ms": 650,
        "loss": 0.25,
        "expect": {
          "encoder_bps_min": 80000,
          "encoder_bps_max": 150000,
          "max_fps_min": 5,
          "max_fps_max": 10,
          "keyframe": true
        }
      },
      {
        "name": "recovering",
        "bandwidth_kbps": 1200,
        "rtt_ms": 180,
        "loss": 0.03,
        "expect": {
          "encoder_bps_min": 800000,
          "encoder_bps_max": 1200000,
          "max_fps_min": 15,
          "max_fps_max": 30,
          "keyframe": false
        }
      },
      {
        "name": "good_again",
        "bandwidth_kbps": 10000,
        "rtt_ms": 40,
        "loss": 0.0,
        "expect": {
          "encoder_bps_min": 2000000,
          "encoder_bps_max": 2500000,
          "max_fps_min": 30,
          "max_fps_max": 30,
          "keyframe": false
        }
      }
    ],
    "expect": {
      "degraded_phases": ["outage", "poor"],
      "recovered_phase": "good_again",
      "require_bitrate_drop": true,
      "require_bitrate_recovery": true
    }
  },
