    WebRtcQosSdk::webrtc_pacing
    WebRtcQosSdk::webrtc_rtp_rtcp
    WebRtcQosSdk::transport_packet_history
    WebRtcQosSdk::role_transport
    Threads::Threads
    dl
    rt
    atomic)
endif()

_webrtc_qos_sdk_have_targets(_webrtc_qos_sdk_can_add_play_role
